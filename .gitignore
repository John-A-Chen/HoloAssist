# =========================
# Node / frontend
# =========================
node_modules/
dist/
.next/
.cache/


# =========================
# External packages
# =========================
# Proper Git submodules are not ignored.
# Unity-side submodules live in ThirdParty/.
# ROS-side submodules live in ros2_ws/src/.
#
# Do NOT ignore:
# ThirdParty/URDF-Importer/
# ThirdParty/ROS-TCP-Connector/
# ros2_ws/src/ROS-TCP-Endpoint/
# ros2_ws/src/Universal_Robots_ROS2_Driver/


# =========================
# Unity generated files
# =========================
Unity/My project/Library/
Unity/My project/Temp/
Unity/My project/Logs/
Unity/My project/Obj/
Unity/My project/obj/
Unity/My project/Build/
Unity/My project/Builds/
Unity/My project/UserSettings/
Unity/My project/.utmp/

# Unity generated project / IDE files
Unity/My project/*.sln
Unity/My project/*.slnx
Unity/My project/*.csproj
Unity/My project/*.pidb
Unity/My project/*.booproj
Unity/My project/.vscode/

# Unity generated metadata / cache
Unity/My project/MemoryCaptures/
Unity/My project/Recordings/

# Unity Burst debug info
Unity/My project/*_BurstDebugInformation_DoNotShip/

# Unity IL2CPP backup output
Unity/My project/*_BackUpThisFolder_ButDontShipItWithYourGame/
**/*_BackUpThisFolder_ButDontShipItWithYourGame/

# Unity XR temp files
Unity/My project/Assets/XR/Temp/

# Unity scene auto-recovery files
Unity/My project/Assets/_Recovery/

# Unity build outputs
Unity/My project/*.apk
Unity/My project/*.aab
*.apk
*.aab


# =========================
# Stray root-level Unity dirs
# These happen if Unity is opened from the wrong folder
# =========================
/Library/
/Logs/
/Temp/
/Obj/
/Build/
/Builds/
/UserSettings/

# Usually do NOT ignore these if this repo root becomes a Unity project root.
# In this repo they are treated as stray root-level folders.
/Packages/
/ProjectSettings/


# =========================
# ROS 2 / colcon
# =========================
build/
install/
log/

**/build/
**/install/
**/log/

# Compiled objects and binaries
*.o
*.so
*.dll
*.exe
*.a
*.lib


# =========================
# Docker workspaces / bind mounts
# =========================
docker/**/ws/
docker/**/build/
docker/**/install/
docker/**/log/


