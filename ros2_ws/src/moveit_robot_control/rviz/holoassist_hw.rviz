          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        cable_connector_1:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        finger_width_mock_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        flange:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        forearm_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        ft_frame:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        gripper_tcp:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        left_finger_tip:
