# =========================
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/c_cpp_properties.json

.vscode/*.db
.vscode/*.db-shm
.vscode/*.db-wal
.vscode/*.db-*
.vscode/ipch/


